# ── CREA3 LexAI chatbot — environment ─────────────────────────────────────────
# Copy to .env and fill in the keys (run_chatbot.sh does this for you on first run).

# Port to expose the chatbot API on (avoid clashing with other services).
BACKEND_PORT=8094

# ── Chat model: Mistral (La Plateforme) ───────────────────────────────────────
# The answer model is Mistral. Get a key at https://console.mistral.ai/.
LLM_TECH_STACK=mistral
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
# Model for answers. Start with ministral-8b-latest; switch to mistral-small-latest
# later if you want stronger reasoning (just change this line and restart).
LLM_MODEL=ministral-8b-latest
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1400

# ── Retrieval embeddings (independent of the chat model) ──────────────────────
# Default = OpenAI text-embedding-3-small, matching the prebuilt 1536-dim FAISS
# indices. This key is used ONLY to embed the query for retrieval — never to
# generate answers (those are 100% Mistral).
EMBEDDING_BACKEND=openai
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=
# To go single-key (Mistral for everything): set EMBEDDING_BACKEND=mistral and
# EMBEDDING_MODEL=mistral-embed, then rebuild the indices:
#   ./run_chatbot.sh --rebuild-mistral

# ── Retrieval / engine tuning ─────────────────────────────────────────────────
RETRIEVAL_TOP_K=4
SYSTEM_MODE=react_agent
TRACE_MAX_CHARS=12000
