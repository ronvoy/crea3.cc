# Frontend config. Copy to frontend/.env.
# Leave VITE_API_BASE empty to use the Vite dev proxy (/api -> :8000).
VITE_API_BASE=

# Keycloak
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=crea
VITE_KEYCLOAK_CLIENT_ID=crea-frontend
VITE_KEYCLOAK_ACCOUNT_URL=http://localhost:8080/realms/crea/account

# Footer / contact
VITE_PROJECT_CONTACT_NAME=CREA3 Team
VITE_PROJECT_CONTACT_EMAIL=info@example.com
VITE_PROJECT_CONTACT_ORG=CREA3 Consortium
VITE_PROJECT_WEBSITE=
