# ── Backend configuration (local, non-Docker runs) ────────────────────────────
API_PORT=8094
API_HOST=0.0.0.0

# ── Chat model: Mistral (La Plateforme) ───────────────────────────────────────
LLM_TECH_STACK=mistral
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
LLM_MODEL=ministral-8b-latest
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096

# ── Retrieval embeddings (default OpenAI, matches prebuilt 1536-dim indices) ──
# Used ONLY to embed the query — never to generate answers.
EMBEDDING_BACKEND=openai
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=

# ── Retrieval / engine tuning ─────────────────────────────────────────────────
RETRIEVAL_TOP_K=4
SYSTEM_MODE=react_agent
TRACE_MAX_CHARS=12000
# VECTOR_DB_ROOT=/app/vector_store
