# Gmail SMTP for Keycloak verification emails
# Requirements:
# - Enable 2-Step Verification on the Google account
# - Create an App Password (use that as SMTP_PASS)

# Root env for docker-compose (Keycloak + SMTP)
# Copy to .env:
#   copy .env.example .env   (PowerShell)  OR  cp .env.example .env (bash)

# # --- Keycloak admin bootstrap ---
# KEYCLOAK_ADMIN=admin
# KEYCLOAK_ADMIN_PASSWORD=admin

# # --- Keycloak realm name (imported) ---
# KEYCLOAK_REALM=crea

# # --- Keycloak listener port on your machine ---
# KEYCLOAK_PORT=8080

# # --- Database (Postgres for Keycloak) ---
# KC_DB_DATABASE=keycloak
# KC_DB_USER=keycloak
# KC_DB_PASSWORD=keycloak

# # --- Reverse-proxy / production optional ---
# # KC_PROXY=edge
# # KC_HOSTNAME=auth.yourdomain.com

# # --- SMTP for verification emails (Keycloak sends these) ---
# # Default (local dev): Mailpit
# SMTP_HOST=mailpit
# SMTP_PORT=1025
# SMTP_FROM=no-reply@crea.local
# SMTP_FROM_NAME=CREA
# SMTP_USER=
# SMTP_PASS=
# SMTP_STARTTLS=false
# SMTP_SSL=false

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM=noreply.crea3@gmail.com
SMTP_FROM_NAME=CREA3
SMTP_USER=noreply.crea3@gmail.com
SMTP_PASS=wxdiifryzplxwyns
SMTP_STARTTLS=true
SMTP_SSL=false


# Deployment environment: 'dev' (devtools toolbar + console) or 'prod'
DEPLOYMENT_ENVIRONMENT=dev
# On-the-fly theme/font (applied in prod; editable via dev toolbar)
FONT_TYPE=Orbitron
THEME_TYPE=blue

# Legal RAG chatbot (OpenRouter). Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
RAG_STORAGE_DIR=./backend/rag_store
