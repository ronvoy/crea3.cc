# Amazon SES SMTP (example: us-east-1)
# Replace host with your SES SMTP endpoint region.
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_FROM=no-reply@yourdomain.com
SMTP_FROM_NAME=CREA
SMTP_USER=YOUR_SES_SMTP_USERNAME
SMTP_PASS=YOUR_SES_SMTP_PASSWORD
SMTP_STARTTLS=true
SMTP_SSL=false
