# API base URL of backend (FastAPI).
#
# Leave empty to use the Vite dev proxy (`/api` -> http://127.0.0.1:8000).
# If you want to bypass the proxy, set it to your backend origin *without* `/api`:
#   VITE_API_BASE=http://127.0.0.1:8000

VITE_API_BASE=

# Keycloak
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=crea
VITE_KEYCLOAK_CLIENT_ID=crea-frontend

# Optional: link to Keycloak account console
VITE_KEYCLOAK_ACCOUNT_URL=http://localhost:8080/realms/crea/account

# Project footer (shown on login and inside the app)
VITE_PROJECT_CONTACT_NAME=Alberto Moccardi
VITE_PROJECT_CONTACT_EMAIL=albertomoccardi@gmail.com
VITE_PROJECT_CONTACT_ORG=CREA3 Consortium
VITE_PROJECT_WEBSITE=
