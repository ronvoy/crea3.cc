# Backend config
DATABASE_URL=sqlite:///./crea3.db

# CORS
CORS_ORIGINS=http://localhost:5173

# Keycloak (OIDC)
# Run Keycloak locally at http://localhost:8080 (docker-compose provided)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=crea
KEYCLOAK_CLIENT_ID=crea-frontend
KEYCLOAK_CLIENT_SECRET=

# Keycloak Admin access (service account)
# The provided docker-compose/realm import creates this client automatically.
KEYCLOAK_ADMIN_CLIENT_ID=crea-backend
KEYCLOAK_ADMIN_CLIENT_SECRET=crea-backend-secret

# Optional: if true, API rejects access tokens when email_verified is false
KEYCLOAK_REQUIRE_VERIFIED_EMAIL=true

# SMTP (used to send the email verification token)
# SMTP settings below are OPTIONAL (only used by legacy backend email code).
# If you use Keycloak email verification (recommended), you can ignore these.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM=noreply.crea3@gmail.com
SMTP_FROM_NAME=CREA3
SMTP_USER=noreply.crea3@gmail.com
SMTP_PASS=wxdiifryzplxwyns
SMTP_STARTTLS=true
SMTP_SSL=false

# ── Public/browser Keycloak URL (issuer validation) ──
KEYCLOAK_PUBLIC_URL=http://localhost:8080

# ── Deployment environment: dev | prod ──
DEPLOYMENT_ENVIRONMENT=dev
FONT_TYPE=Orbitron
THEME_TYPE=blue

# ── Admin access to /rag (Legal Knowledge Base management) ──
ADMIN_USER=ADMIN
ADMIN_PASS=ADMIN

# ── Legal RAG chatbot (OpenRouter) ──
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
RAG_STORAGE_DIR=./rag_store
