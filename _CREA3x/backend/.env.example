# Backend config. Copy to backend/.env and fill in. NEVER commit a real .env.

DATABASE_URL=sqlite:///./crea3.db

# CORS: comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173

# --- Keycloak (OpenID Connect): the only authentication system ---
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=crea
KEYCLOAK_CLIENT_ID=crea-frontend
# Only needed if the frontend client is confidential (usually empty/public):
KEYCLOAK_CLIENT_SECRET=

# Backend service account (confidential client). This MUST match the
# `crea-backend` client secret configured in infra/keycloak/realm-crea.json.
KEYCLOAK_ADMIN_CLIENT_ID=crea-backend
KEYCLOAK_ADMIN_CLIENT_SECRET=__CHANGE_ME_MUST_MATCH_REALM__

KEYCLOAK_REQUIRE_VERIFIED_EMAIL=true
EMAIL_VERIFICATION_TTL_MINUTES=1440

# --- Workflow Assistant (local Ollama) ---
# Change OLLAMA_MODEL to swap models. The model must be pulled first:
#   ollama pull llama3.2:3b
# Good small options: llama3.2:3b, qwen2.5:3b, phi3:mini, gemma2:2b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=60

# --- Workflow Assistant fallback (OpenRouter, hosted) ---
# Used ONLY when the Ollama endpoint above is unreachable. Ollama is never
# overridden. Leave OPENROUTER_API_KEY empty to disable the fallback.
# OPENROUTER_MODEL is a COMMA-SEPARATED list tried in order — free model ids
# rotate/rate-limit often, so listing several (different providers) keeps the
# assistant working when one is retired. Ids: https://openrouter.ai/models
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=inclusionai/ling-3.0-flash:free,google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3-super-120b-a12b:free,openai/gpt-oss-20b:free
OPENROUTER_TIMEOUT_SECONDS=25
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=CREA3

# --- Legal AI Assistant (external RAG service, hosted elsewhere) ---
# The full URL of the upstream /chat endpoint. Leave empty to disable the page.
LEGAL_AI_URL=
LEGAL_AI_TIMEOUT_SECONDS=30

# --- SMTP (backend-sent emails, e.g. dispute invitations) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM=noreply.example@example.com
SMTP_FROM_NAME=CREA3
SMTP_USER=noreply.example@example.com
SMTP_PASS=__CHANGE_ME__
SMTP_STARTTLS=true
SMTP_SSL=false

# Public link included in invitation emails.
PUBLIC_INVITE_LINK=http://localhost:5173/app

# --- Admin panel (/admin -> /admin/dashboard) ---
# Standalone admin login, independent of Keycloak. Server-side only.
# Generate a strong secret:  python3 -c "import secrets;print(secrets.token_urlsafe(48))"
# If any of these is empty the panel refuses to issue tokens (no default login).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=__CHANGE_ME__
ADMIN_JWT_SECRET=__CHANGE_ME_LONG_RANDOM__
ADMIN_SESSION_MINUTES=120
