# Backend config
DATABASE_URL=sqlite:///./crea3.db

# CORS
CORS_ORIGINS=http://localhost:5173

# Keycloak (OIDC)
# Run Keycloak locally at http://localhost:8080 (docker-compose provided)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=crea
KEYCLOAK_CLIENT_ID=crea-frontend
KEYCLOAK_CLIENT_SECRET=

# Keycloak Admin access (service account)
# The provided docker-compose/realm import creates this client automatically.
# Must match the crea-backend client secret in infra/keycloak/realm-crea.json.
KEYCLOAK_ADMIN_CLIENT_ID=crea-backend
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me

# Optional: if true, API rejects access tokens when email_verified is false
KEYCLOAK_REQUIRE_VERIFIED_EMAIL=true

# SMTP — sends account verification + password reset codes.
# CREA3.cc mail server. Port 465 = SMTP over SSL (implicit TLS).
SMTP_HOST=mail.crea3.cc
SMTP_PORT=465
SMTP_FROM=info@crea3.cc
SMTP_FROM_NAME=CREA3
SMTP_USER=info@crea3.cc
SMTP_PASS=9818@Crea
SMTP_STARTTLS=false
SMTP_SSL=true

# ── Public/browser Keycloak URL (issuer validation) ──
KEYCLOAK_PUBLIC_URL=http://localhost:8080

# ── Deployment environment: dev | prod ──
DEPLOYMENT_ENVIRONMENT=dev
FONT_TYPE=Orbitron
THEME_TYPE=blue

# ── Admin access to /rag (Legal Knowledge Base management) ──
ADMIN_USER=ADMIN
ADMIN_PASS=ADMIN

# ── DB Browser (/dbms) credentials ──
DBMS_USER=ADMIN
DBMS_PASS=CREA3

# ── Legal RAG chatbot (OpenRouter) ──
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
RAG_STORAGE_DIR=./rag_store

# ── Google OAuth (next pipeline: "Sign in with Google") ──
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:8000/api/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
