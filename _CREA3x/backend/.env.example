# Backend config. Copy to backend/.env and fill in. NEVER commit a real .env.

DATABASE_URL=sqlite:///./crea3.db

# CORS: comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173

# --- Keycloak (OpenID Connect): the only authentication system ---
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=crea
KEYCLOAK_CLIENT_ID=crea-frontend
# Only needed if the frontend client is confidential (usually empty/public):
KEYCLOAK_CLIENT_SECRET=

# Backend service account (confidential client). This MUST match the
# `crea-backend` client secret configured in infra/keycloak/realm-crea.json.
KEYCLOAK_ADMIN_CLIENT_ID=crea-backend
KEYCLOAK_ADMIN_CLIENT_SECRET=__CHANGE_ME_MUST_MATCH_REALM__

KEYCLOAK_REQUIRE_VERIFIED_EMAIL=true
EMAIL_VERIFICATION_TTL_MINUTES=1440

# --- Workflow Assistant (local Ollama) ---
# Change OLLAMA_MODEL to swap models. The model must be pulled first:
#   ollama pull llama3.2:3b
# Good small options: llama3.2:3b, qwen2.5:3b, phi3:mini, gemma2:2b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=60

# --- Workflow Assistant fallback (OpenRouter, hosted) ---
# Used ONLY when the Ollama endpoint above is unreachable. Ollama is never
# overridden. Leave OPENROUTER_API_KEY empty to disable the fallback.
# OPENROUTER_MODEL is a COMMA-SEPARATED list tried in order — free model ids
# rotate/rate-limit often, so listing several (different providers) keeps the
# assistant working when one is retired. Ids: https://openrouter.ai/models
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=inclusionai/ling-3.0-flash:free,google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3-super-120b-a12b:free,openai/gpt-oss-20b:free
OPENROUTER_TIMEOUT_SECONDS=25
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=CREA3

# --- Unified assistant (single classifier-routed chatbot) ---
# The PRIMARY LLM endpoint (Ollama-native). PRIMARY_LLM_URL / PRIMARY_LLM_MODEL
# are aliases of OLLAMA_BASE_URL / OLLAMA_MODEL above — set either. Every request
# tries this first and only falls back to OpenRouter when it's unreachable.
# PRIMARY_LLM_URL=http://host.docker.internal:11434
# PRIMARY_LLM_MODEL=llama3.2:3b
# Legal AI + intent classifier pin the OpenRouter fallback to Mistral:
LEGAL_OPENROUTER_MODEL=mistralai/mistral-7b-instruct:free

# --- Knowledge Base embeddings (RAG) ---
# Requested THROUGH OpenRouter using OPENROUTER_API_KEY (OpenAI-compatible
# /embeddings). If OpenRouter can't serve embeddings for this model, retrieval
# falls back to BM25 automatically. Override the endpoint to any OpenAI-compatible
# embeddings provider with EMBEDDINGS_BASE_URL / EMBEDDINGS_API_KEY.
OPENROUTER_EMBED_MODEL=openai/text-embedding-3-small
EMBEDDINGS_BASE_URL=
EMBEDDINGS_API_KEY=

# --- Voice: Speech-to-text (STT) ---
# OpenRouter has NO audio API. Set a configurable OpenAI-compatible
# /audio/transcriptions endpoint (self-hosted faster-whisper, Groq free Whisper,
# or OpenAI). When unset, the browser's Web Speech API is used (Chrome/Edge/Safari).
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=whisper-1

# --- Voice: Text-to-speech (TTS) ---
# Configurable OpenAI-compatible /audio/speech endpoint — e.g. a self-hosted
# Kokoro (Kokoro-FastAPI) which is free + low-latency, or OpenAI. When unset, the
# browser's speechSynthesis voice is used.
#   Kokoro example: TTS_BASE_URL=http://host.docker.internal:8880/v1
#                   TTS_MODEL=kokoro   TTS_VOICE=af_bella
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=kokoro
TTS_VOICE=af_bella
TTS_FORMAT=mp3

# --- Voice/embeddings via Gemini (optional alternative) ---
# If set, Gemini is used for STT (and can transcribe) when no STT_BASE_URL is
# configured. Leave empty to keep everything OpenRouter/Kokoro/browser-based.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_STT_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=45

# --- Legal AI Assistant (external RAG service, hosted elsewhere) ---
# The full URL of the upstream /chat endpoint. Leave empty to disable the page.
LEGAL_AI_URL=
LEGAL_AI_TIMEOUT_SECONDS=30

# --- SMTP (backend-sent emails, e.g. dispute invitations) ---
# This is also the "info" mailbox account for the admin Mail tab (IMAP over :993).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM=info@crea3.cc
SMTP_FROM_NAME=CREA3
SMTP_USER=info@crea3.cc
SMTP_PASS=__CHANGE_ME__
SMTP_STARTTLS=true
SMTP_SSL=false

# --- Support mailbox (in-app "Contact support" + admin Mail tab 2nd account) ---
# Contact-support requests are delivered TO SUPPORT_EMAIL, sent FROM SUPPORT_FROM.
SUPPORT_EMAIL=support@crea3.cc
SUPPORT_FROM=info@crea3.cc
SUPPORT_FROM_NAME=CREA3 Support
# Credentials for the support@ mailbox, so the admin Mail tab can read it over
# IMAP (:993). Leave IMAP host blank to reuse SMTP_HOST. If unset, the admin Mail
# tab simply won't offer the support@ account.
SUPPORT_IMAP_HOST=
SUPPORT_IMAP_USER=support@crea3.cc
SUPPORT_IMAP_PASS=__CHANGE_ME__

# Public link included in invitation emails.
PUBLIC_INVITE_LINK=http://localhost:5173/app

# --- Admin panel (/admin -> /admin/dashboard) ---
# Standalone admin login, independent of Keycloak. Server-side only.
# Generate a strong secret:  python3 -c "import secrets;print(secrets.token_urlsafe(48))"
# If any of these is empty the panel refuses to issue tokens (no default login).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=__CHANGE_ME__
ADMIN_JWT_SECRET=__CHANGE_ME_LONG_RANDOM__
ADMIN_SESSION_MINUTES=120

# Assistant delivery: 1 = polling (tunnel-cap safe); 0 = SSE streaming.
TUNNEL_CAP=1
